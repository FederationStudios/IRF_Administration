{
  "name": "irf_administration",
  "version": "2.9.0",
  "description": "Administration bot for the Immortal Robloxian Federation",
  "main": "index.js",
  "scripts": {
    "test": "pnpm exec tsc -b && cd dist && node index.js",
    "build": "pnpm exec tsc -b",
    "prestart": "pnpm exec tsc -b",
    "start": "cd dist && node index.js",
    "lint": "pnpm exec eslint --fix ./src",
    "clean": "rm -r dist/*"
  },
  "keywords": [
    "discord.js",
    "discord",
    "bot",
    "automation"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  },
  "author": {
    "name": "Federation Studios",
    "url": "https://github.com/FederationStudios"
  },
  "contributors": [
    {
      "name": "TaviShadows (Tavi)",
      "email": "github@sl.tavis.page",
      "url": "https://tavis.page"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "discord.js": "14.28.1",
    "eslint-config-prettier": "^10.1.8",
    "mysql2": "3.24.6",
    "sequelize": "6.37.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.16.0",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "undici": "^6.22.0"
  },
  "type": "module"
}